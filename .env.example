# Copy to .env.local for local dev. Next.js loads .env.local automatically.
# Set the same names in the Vercel project for production. Never commit .env.local.

# Canonical public URL. Read by src/lib/site.ts.
# Used for metadata, Open Graph, sitemap, robots.txt, JSON-LD, and the QR caption.
# Inlined at build time. If unset, the code falls back to https://hungryana.com.
NEXT_PUBLIC_SITE_URL=https://hungryana.com

# Server-only. Read by src/lib/google-sheets.ts.
# Google Apps Script web app URL that appends contact-form rows.
# POST /api/contact returns 500 until this is set. Do not prefix with NEXT_PUBLIC_.
# Setup: GOOGLE_SHEETS_SETUP.md and scripts/google-sheets-webhook.gs
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Not read by any file in this repository. Older notes in DEPLOYMENT.md mention it.
# Analytics that actually runs is Vercel Web Analytics in src/app/layout.tsx, which needs no key.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
